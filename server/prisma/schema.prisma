generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  nickname     String?
  avatar       String?
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  orders  Order[]
  coupons UserCoupon[]
  reviews Review[]

  @@map("users")
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String    @map("password_hash")
  nickname     String?
  avatar       String?
  status       Int       @default(1)
  roleId       Int       @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id])
  lastLoginAt   DateTime? @map("last_login_at")
  inventoryLogs InventoryLog[]
  auditLogs     AuditLog[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([roleId])
  @@map("admin_users")
}

model Role {
  id          Int         @id @default(autoincrement())
  name        String
  code        String      @unique
  description String?
  permissions String[]
  admins      AdminUser[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("admin_roles")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  icon      String?
  sort      Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id            Int      @id @default(autoincrement())
  title         String
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2) @map("original_price")
  cover         String
  images        String[]
  description   String?  @db.Text
  sales         Int      @default(0)
  stock         Int      @default(0)
  threshold     Int      @default(10)
  status        Int      @default(1)
  categoryId    Int      @map("category_id")
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  items          OrderItem[]
  reviews        Review[]
  inventoryLogs  InventoryLog[]

  @@index([categoryId])
  @@map("products")
}

model Banner {
  id        Int      @id @default(autoincrement())
  image     String
  link      String?
  sort      Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("banners")
}

model Announcement {
  id          Int       @id @default(autoincrement())
  title       String
  content     String    @db.Text
  link        String?
  status      Int       @default(0)
  sort        Int       @default(0)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("announcements")
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNo     String      @unique @map("order_no")
  userId      Int         @map("user_id")
  user        User        @relation(fields: [userId], references: [id])
  totalAmount Decimal     @db.Decimal(10, 2) @map("total_amount")
  status      Int         @default(0)
  receiver    Json
  remark      String?
  paidAt      DateTime?   @map("paid_at")
  shippedAt   DateTime?   @map("shipped_at")
  completedAt DateTime?   @map("completed_at")
  cancelledAt DateTime?   @map("cancelled_at")
  shipCompany String?     @map("ship_company")
  shipNo      String?     @map("ship_no")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  items          OrderItem[]
  refund         RefundRequest?
  originalAmount Decimal?      @db.Decimal(10, 2) @map("original_amount")
  discountAmount Decimal?      @db.Decimal(10, 2) @map("discount_amount")
  coupons        UserCoupon[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int      @map("product_id")
  product      Product  @relation(fields: [productId], references: [id])
  productTitle String   @map("product_title")
  productCover String   @map("product_cover")
  price        Decimal  @db.Decimal(10, 2)
  quantity     Int

  @@index([orderId])
  @@map("order_items")
}

model RefundRequest {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason    String
  amount    Decimal  @db.Decimal(10, 2)
  status    Int      @default(0)
  remark    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("refund_requests")
}

model Coupon {
  id           Int      @id @default(autoincrement())
  name         String
  type         Int
  threshold    Decimal? @db.Decimal(10, 2)
  amount       Decimal  @db.Decimal(10, 2)
  description  String?  @db.Text
  validFrom    DateTime @map("valid_from")
  validTo      DateTime @map("valid_to")
  total        Int
  perUserLimit Int      @default(1) @map("per_user_limit")
  status       Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userCoupons UserCoupon[]

  @@map("coupons")
}

model UserCoupon {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  user       User      @relation(fields: [userId], references: [id])
  couponId   Int       @map("coupon_id")
  coupon     Coupon    @relation(fields: [couponId], references: [id])
  status     Int       @default(0)
  source     Int       @default(0)
  receivedAt DateTime  @default(now()) @map("received_at")
  usedAt     DateTime? @map("used_at")
  expiresAt  DateTime? @map("expires_at")
  orderId    Int?      @unique @map("order_id")
  order      Order?    @relation(fields: [orderId], references: [id])
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([couponId])
  @@map("user_coupons")
}

model Review {
  id        Int       @id @default(autoincrement())
  productId Int       @map("product_id")
  product   Product   @relation(fields: [productId], references: [id])
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  rating    Int
  content   String    @db.Text
  images    String[]
  status    Int       @default(0)
  reply     String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([productId, status])
  @@index([userId])
  @@index([status])
  @@map("reviews")
}

model InventoryLog {
  id          Int       @id @default(autoincrement())
  productId   Int       @map("product_id")
  product     Product   @relation(fields: [productId], references: [id])
  type        Int
  quantity    Int
  reason      String?
  operatorId  Int?      @map("operator_id")
  operator    AdminUser? @relation(fields: [operatorId], references: [id])
  beforeStock Int       @map("before_stock")
  afterStock  Int       @map("after_stock")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@map("inventory_logs")
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  adminId    Int?      @map("admin_id")
  admin      AdminUser? @relation(fields: [adminId], references: [id])
  action     String
  resource   String
  resourceId Int?      @map("resource_id")
  payload    Json?
  ip         String?
  userAgent  String?    @map("user_agent")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([resource, createdAt])
  @@map("audit_logs")
}

model Setting {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  value       Json
  group       String    @default("general")
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([group])
  @@map("settings")
}

